{
  "manifest_version": 3,
  "name": "ACA-utils",
  "version": "1.0.0",
  "description": "Adds separate supported-application dashboards to the IT Compliance Scorecard and ESATS.",
  "permissions": [],
  "host_permissions": [
    "https://scorecard-ui.tas-ewd.apps.boeing.com/*",
    "https://scorecard-api.tas-ewd.apps.boeing.com/*",
    "https://esats.web.boeing.com/*",
    "https://service-gateway.tas-phx.apps.boeing.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scorecard-ui.tas-ewd.apps.boeing.com/*"
      ],
      "css": [
        "host.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://esats.web.boeing.com/*"
      ],
      "css": [
        "esats-host.css"
      ],
      "js": [
        "esats-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "styles.css",
        "js/*.js"
      ],
      "matches": [
        "https://scorecard-ui.tas-ewd.apps.boeing.com/*"
      ]
    },
    {
      "resources": [
        "esats-dashboard.html",
        "esats-styles.css",
        "js/*.js"
      ],
      "matches": [
        "https://esats.web.boeing.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aca-compliance-dashboard@boeing.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
